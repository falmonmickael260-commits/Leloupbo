# --- Le Village des Blackops (La Meute) ---
PORT=3000
DATA_DIR=
PROFILES_DIR=

# Profils propres à ce jeu : Supabase si définies, sinon fichier local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Voix (LiveKit, optionnel — sinon pair-à-pair)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Intégration Revanche Game (optionnelle) ---
# Sans ces variables, La Meute fonctionne exactement comme avant, avec son
# propre système de profils ci-dessus. Voir docs/PLATFORM.md dans le repo
# revanche-games-web.
#
# Secret HMAC partagé avec la coquille, pour vérifier l'identité du joueur
# transmise via ?rg_token= à l'ouverture d'une partie.
# PLATFORM_SHARED_SECRET=
#
# Projet Supabase central (comptes, profils, statistiques) — distinct de
# SUPABASE_URL ci-dessus, qui ne sert qu'aux profils propres à ce jeu.
# PLATFORM_SUPABASE_URL=https://wrsmtdtzilpckfcjmyri.supabase.co
# PLATFORM_SUPABASE_SERVICE_ROLE_KEY=    <-- secret, jamais commité
